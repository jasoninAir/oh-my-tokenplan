#!/usr/bin/env python3
"""bin/agentrace: agentrace protocol CLI。

命令:
- init: 初始化模板
- install-snippet: 安装用户级片段
- new-story: 创建 Story
- new-review: 创建 Review
- advance: 状态推进
- sync: 同步 AGENTS.md 表格
- check: 校验全集
- render: 生成 OVERVIEW
- resume / triage: 突发熔断现场勘查
- impact: 代码影响面分析
"""
from __future__ import annotations
import argparse
import datetime
import re
import subprocess
import sys
from pathlib import Path

import yaml

# ============ 公共辅助 ============


def _parse_md(path: Path) -> tuple[dict, str]:
    """读 .md frontmatter + body，返回 (fm_dict, body_str)。"""
    text = path.read_text()
    if not text.startswith("---"):
        return {}, text
    parts = text.split("---", 2)
    if len(parts) < 3:
        return {}, text
    return yaml.safe_load(parts[1]) or {}, parts[2]


def _write_md(path: Path, fm: dict, body: str):
    """写回 .md（含 frontmatter）。"""
    text = "---\n" + yaml.safe_dump(fm, allow_unicode=True, sort_keys=False) + "---" + body
    path.write_text(text)


def _next_id(directory: Path, prefix: str) -> int:
    """扫 directory 返回 max ID + 1。prefix 如 'S-' / 'R-'。"""
    max_id = 0
    pat = re.compile(rf"{re.escape(prefix)}(\d+)")
    for f in directory.glob(f"{prefix}*.md"):
        m = pat.match(f.name)
        if m:
            max_id = max(max_id, int(m.group(1)))
    return max_id + 1


def _slugify(title: str) -> str:
    """中文 title 留待 v0.2；这里做 ascii 化简版。"""
    s = title.lower().strip()
    s = re.sub(r"\s+", "-", s)
    s = re.sub(r"[^a-z0-9-]", "", s)
    return s or "untitled"


# ============ init ============

INIT_TEMPLATES: dict[str, str] = {
    "docs/agentrace/stories/_TEMPLATE.md": """---
id: S-NNN
title: <title>
status: draft
author: __USER__
assignee: ""
created: __TODAY__
updated: __TODAY__
depends_on: []
blocks: []
related_reviews: []
related_commits: []
impacted_symbols: []
tags: []
priority: P1
blocked_by: ""
---

## 背景

## 范围

## 验收标准

- [ ] 条件 1

## 技术备注

## 实现日志

- __TODAY__  status: draft
""",
    "docs/agentrace/reviews/_TEMPLATE.md": """---
id: R-NNN
story: S-MMM
reviewer: __USER__
created: __TODAY__
based_on_commits: []
iteration: 1
verdict: needs_discussion
addresses_reviews: []
---

## 总结

## Blocker

## 非 Blocker

## 提问 / 讨论

## 关联
""",
    "AGENTS.md": """# AGENTS

## 当前激活 Story

<!-- bin/agentrace sync -->

## 工作流

1. bin/agentrace new-story --title "..."
2. bin/agentrace advance S-NNN in_progress
""",
}


def cmd_init(args):
    cwd = Path.cwd()
    if (cwd / "AGENTS.md").exists():
        print("error: AGENTS.md 已存在，拒绝覆盖", file=sys.stderr)
        sys.exit(1)

    import getpass
    user = getpass.getuser()
    today = datetime.date.today().isoformat()

    for relpath, content in INIT_TEMPLATES.items():
        target = cwd / relpath
        target.parent.mkdir(parents=True, exist_ok=True)
        content = content.replace("__USER__", user).replace("__TODAY__", today)
        target.write_text(content)

    print(f"initialized: agentrace 协议模板在 {cwd}")
    print('  下一步: bin/agentrace new-story --title "第一个 story"')


# ============ new-story ============


def cmd_new_story(args):
    stories_dir = Path.cwd() / "docs/agentrace/stories"
    if not stories_dir.exists():
        print(f"error: {stories_dir} 不存在，请先 bin/agentrace init", file=sys.stderr)
        sys.exit(1)

    template = stories_dir / "_TEMPLATE.md"
    if not template.exists():
        print(f"error: {template} 缺失", file=sys.stderr)
        sys.exit(1)

    next_id = _next_id(stories_dir, "S-")
    title = args.title or "Untitled story"
    slug = _slugify(title)
    today = datetime.date.today().isoformat()

    content = template.read_text()
    content = content.replace("S-NNN", f"S-{next_id:03d}")
    content = content.replace("<title>", title)
    content = content.replace("<YYYY-MM-DD>", today)
    content = re.sub(r"author: [^\n]*", "author: test-author", content)

    target = stories_dir / f"S-{next_id:03d}-{slug}.md"
    target.write_text(content)
    print(f"created: {target.relative_to(Path.cwd())}")


# ============ new-review ============


def cmd_new_review(args):
    story_id = args.story_id
    stories_dir = Path.cwd() / "docs/agentrace/stories"
    reviews_dir = Path.cwd() / "docs/agentrace/reviews"

    matches = list(stories_dir.glob(f"{story_id}-*.md"))
    if not (stories_dir / f"{story_id}.md").exists() and not matches:
        print(f"error: story {story_id} not found in {stories_dir}", file=sys.stderr)
        sys.exit(1)

    template = reviews_dir / "_TEMPLATE.md"
    if not template.exists():
        print(f"error: {template} 缺失", file=sys.stderr)
        sys.exit(1)

    next_id = _next_id(reviews_dir, "R-")
    today = datetime.date.today().isoformat()

    content = template.read_text()
    content = content.replace("R-NNN", f"R-{next_id:03d}")
    content = content.replace("S-MMM", story_id)
    content = content.replace("<YYYY-MM-DD>", today)

    target = reviews_dir / f"R-{next_id:03d}-on-{story_id}.md"
    target.write_text(content)
    print(f"created: {target.relative_to(Path.cwd())}")


# ============ advance ============

VALID_TRANSITIONS = {
    ("draft", "planned"),
    ("planned", "in_progress"),
    ("in_progress", "in_review"),
    ("in_progress", "blocked"),
    ("in_review", "done"),
    ("in_review", "in_progress"),
    ("in_review", "blocked"),
    ("planned", "blocked"),
    ("draft", "blocked"),
    ("blocked", "planned"),
    ("blocked", "in_progress"),
    ("blocked", "in_review"),
}

VALID_STATUSES = {"draft", "planned", "in_progress", "in_review", "blocked", "done", "rejected"}


def cmd_advance(args):
    story_id = args.story_id
    new_status = args.new_status

    stories_dir = Path.cwd() / "docs/agentrace/stories"
    matches = list(stories_dir.glob(f"{story_id}-*.md"))
    if not matches:
        print(f"error: story {story_id} not found", file=sys.stderr)
        sys.exit(1)
    story_file = matches[0]

    fm, body = _parse_md(story_file)
    current = fm.get("status")

    if (current, new_status) not in VALID_TRANSITIONS:
        print(f"error: invalid transition {current} → {new_status}", file=sys.stderr)
        sys.exit(1)

    if new_status == "in_progress" and not fm.get("assignee"):
        print("error: planned → in_progress requires assignee", file=sys.stderr)
        sys.exit(1)

    if new_status == "in_review" and not fm.get("related_commits"):
        print("warning: in_progress → in_review but related_commits 为空", file=sys.stderr)

    old_status = current
    fm["status"] = new_status
    fm["updated"] = datetime.date.today().isoformat()

    timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    changelog_line = f"- {timestamp}  status: {old_status} → {new_status}"
    body = body.rstrip() + "\n" + changelog_line + "\n"

    _write_md(story_file, fm, body)
    print(f"advanced: {story_id} {old_status} → {new_status}")


# ============ sync ============

SYMBOLS_CACHE = ".agents/symbols-cache.yaml"


def cmd_sync(args):
    cwd = Path.cwd()
    agents_md = cwd / "AGENTS.md"
    stories_dir = cwd / "docs/agentrace/stories"

    if not stories_dir.exists():
        print("error: docs/agentrace/stories/ 不存在", file=sys.stderr)
        sys.exit(1)

    cache_path = cwd / SYMBOLS_CACHE
    symbols_cache: dict[str, list[str]] = {}
    if cache_path.exists():
        symbols_cache = yaml.safe_load(cache_path.read_text()) or {}

    stories = []
    for f in sorted(stories_dir.glob("S-*.md")):
        fm, body = _parse_md(f)
        if not fm:
            continue
        sid = fm.get("id", f.stem)
        if sid in symbols_cache:
            fm["impacted_symbols"] = symbols_cache[sid]
        stories.append({
            "id": sid,
            "title": fm.get("title", ""),
            "status": fm.get("status", ""),
            "assignee": fm.get("assignee", "") or "—",
        })
        # 写回 frontmatter（如 impacted_symbols 有更新）
        new_text = "---\n" + yaml.safe_dump(fm, allow_unicode=True, sort_keys=False) + "---" + body
        if new_text != f.read_text():
            f.write_text(new_text)

    table = "| ID | 标题 | 状态 | 负责人 |\n|----|------|------|--------|\n"
    for s in stories:
        table += f"| {s['id']} | {s['title']} | {s['status']} | {s['assignee']} |\n"

    if agents_md.exists():
        text = agents_md.read_text()
        marker = "<!-- bin/agentrace sync -->"
        if marker in text:
            before, _, after = text.partition(marker)
            new_text = before + marker + "\n\n" + table + "\n" + after
            agents_md.write_text(new_text)
            print(f"synced: AGENTS.md updated with {len(stories)} stories")
        else:
            print("warning: AGENTS.md 缺少 <!-- bin/agentrace sync --> 标记", file=sys.stderr)
    else:
        print("warning: AGENTS.md 不存在，跳过同步", file=sys.stderr)


# ============ check ============


def cmd_check(args):
    errors: list[str] = []
    warnings: list[str] = []
    strict = args.strict

    cwd = Path.cwd()
    stories_dir = cwd / "docs/agentrace/stories"
    reviews_dir = cwd / "docs/agentrace/reviews"

    story_files = sorted(stories_dir.glob("S-*.md")) if stories_dir.exists() else []
    story_ids: set[str] = set()
    for sf in story_files:
        fm, body = _parse_md(sf)
        sid = fm.get("id")
        if not sid:
            errors.append(f"{sf.name}: 缺 id")
            continue
        for field in ("title", "status", "author", "created", "updated"):
            if field not in fm:
                errors.append(f"{sf.name}: 缺 {field}")
        if fm.get("status") not in VALID_STATUSES:
            errors.append(f"{sf.name}: status 非法 {fm.get('status')!r}")
        if sid in story_ids:
            errors.append(f"{sf.name}: 重复 S ID {sid}")
        story_ids.add(sid)
        # 受 dirty workspace 提示（rule #22）
        try:
            dirty = subprocess.run(
                ["git", "status", "--porcelain"],
                cwd=cwd, capture_output=True, text=True, check=False,
            ).stdout.strip()
            if dirty and fm.get("status") == "in_progress":
                warnings.append(f"{sf.name}: 接力提示 - 存在 dirty 工作区，可考虑 bin/agentrace resume")
        except Exception:
            pass

    review_files = sorted(reviews_dir.glob("R-*.md")) if reviews_dir.exists() else []
    review_ids: set[str] = set()
    for rf in review_files:
        fm, body = _parse_md(rf)
        rid = fm.get("id")
        story_ref = fm.get("story")
        verdict = fm.get("verdict")

        if not rid:
            errors.append(f"{rf.name}: 缺 id")
        else:
            if rid in review_ids:
                errors.append(f"{rf.name}: 重复 R ID {rid}")
            review_ids.add(rid)

        if story_ref and story_ref not in story_ids:
            errors.append(f"{rf.name}: 引用不存在的 story {story_ref}")

        if verdict not in {"approved", "changes_requested", "needs_discussion", None}:
            errors.append(f"{rf.name}: verdict 非法 {verdict!r}")

        if "## Blocker" not in body and "## 总结" not in body:
            warnings.append(f"{rf.name}: 缺 ## Blocker 或 ## 总结 章节")

    for adapter in ("CLAUDE.md", "GEMINI.md"):
        p = cwd / adapter
        if p.exists() and "AGENTS.md" not in p.read_text():
            warnings.append(f"{adapter}: 缺 AGENTS.md 反向引用")

    if errors:
        print(f"check: {len(errors)} error(s)", file=sys.stderr)
        for e in errors:
            print(f"  ERROR  {e}", file=sys.stderr)
    if warnings and strict:
        print(f"check: {len(warnings)} warning(s) (--strict)", file=sys.stderr)
        for w in warnings:
            print(f"  WARN  {w}", file=sys.stderr)
        sys.exit(1)
    if warnings:
        print(f"check: {len(warnings)} warning(s)")
    if errors:
        sys.exit(1)

    print(f"check: passed ({len(story_files)} stories, {len(review_files)} reviews)")


# ============ render ============


def cmd_render(args):
    cwd = Path.cwd()
    stories_dir = cwd / "docs/agentrace/stories"

    if not stories_dir.exists():
        print("error: docs/agentrace/stories/ 不存在", file=sys.stderr)
        sys.exit(1)

    by_status: dict[str, list[dict]] = {}
    for f in sorted(stories_dir.glob("S-*.md")):
        fm, _ = _parse_md(f)
        status = fm.get("status", "unknown")
        by_status.setdefault(status, []).append(fm)

    lines = [
        "# 项目进度概览",
        "",
        f"_generated by bin/agentrace render at {datetime.datetime.now().isoformat()}_",
        "",
    ]
    status_order = ["in_progress", "in_review", "blocked", "planned", "draft", "done", "rejected"]
    for status in status_order:
        if status not in by_status:
            continue
        lines.append(f"## {status} ({len(by_status[status])})")
        lines.append("")
        for s in by_status[status]:
            lines.append(f"- **{s.get('id', '?')}** {s.get('title', '')} (assignee: {s.get('assignee', '—')})")
        lines.append("")

    target = cwd / "docs/agentrace/OVERVIEW.md"
    target.write_text("\n".join(lines))
    print(f"rendered: {target.relative_to(cwd)}")


# ============ install-snippet ============


def cmd_install_snippet(args):
    import os
    cwd = Path.cwd()
    home = Path(os.environ.get("HOME", str(Path.home())))

    agents_for_path = {
        "claude": home / ".claude/CLAUDE.md",
        "antigravity": home / ".gemini/config/GEMINI.md",
    }
    snippets_dir = cwd / "adapters/snippets"
    snippet_file_map = {
        "claude": snippets_dir / "claude.md",
        "antigravity": snippets_dir / "antigravity.md",
    }

    targets = [args.agent] if args.agent else list(agents_for_path.keys())

    for agent in targets:
        if agent not in agents_for_path:
            print(f"warning: 未知 agent {agent}，跳过", file=sys.stderr)
            continue
        snippet_path = snippet_file_map[agent]
        target_path = agents_for_path[agent]
        if not snippet_path.exists():
            print(f"warning: {snippet_path} 不存在，跳过 {agent}", file=sys.stderr)
            continue

        snippet_content = snippet_path.read_text()
        target_path.parent.mkdir(parents=True, exist_ok=True)
        existing = target_path.read_text() if target_path.exists() else ""

        pattern = re.compile(
            r"<!-- BEGIN agentrace-protocol v[\d.]+.*?-->.*?<!-- END agentrace-protocol v[\d.]+.*?-->",
            re.DOTALL,
        )
        if pattern.search(existing):
            new_content = pattern.sub(snippet_content.strip(), existing, count=1)
            action = "updated"
        else:
            new_content = existing.rstrip() + "\n\n" + snippet_content
            action = "appended"

        target_path.write_text(new_content)
        print(f"install-snippet: {action} {target_path}")


# ============ resume / triage (现场勘查) ============


def _gather_dirty_files(cwd: Path) -> list[tuple[str, str]]:
    """返回 [(status_prefix, filename), ...]"""
    try:
        out = subprocess.run(
            ["git", "status", "--porcelain"],
            cwd=cwd, capture_output=True, text=True, check=False,
        ).stdout.strip()
    except Exception:
        return []
    if not out:
        return []
    files = []
    for line in out.split("\n"):
        parts = line.split()
        if len(parts) >= 2:
            files.append((parts[0], parts[-1]))
    return files


def _extract_python_symbols(cwd: Path, filenames: list[str]) -> list[str]:
    """用 ast 提取 Python 文件中的函数 / 类名。"""
    import ast as _ast

    symbols = []
    for fname in filenames:
        # 处理 git status 可能给出的 quoted 路径
        clean = fname.strip('"').strip("'")
        fpath = cwd / clean
        if fpath.suffix != ".py" or not fpath.exists():
            continue
        try:
            tree = _ast.parse(fpath.read_text(encoding="utf-8"))
            for node in _ast.walk(tree):
                if isinstance(node, _ast.FunctionDef):
                    symbols.append(f"function `{node.name}` in {clean}")
                elif isinstance(node, _ast.ClassDef):
                    symbols.append(f"class `{node.name}` in {clean}")
        except Exception:
            pass
    return symbols


def cmd_resume(args):
    cwd = Path.cwd()
    print("==================== 现场接力简报 (Auto-Triaged) ====================")

    # 1. 当前激活 Story
    stories_dir = cwd / "docs/agentrace/stories"
    active_story = "无"
    if stories_dir.exists():
        for sf in stories_dir.glob("S-*.md"):
            fm, _ = _parse_md(sf)
            if fm.get("status") == "in_progress":
                active_story = f"{fm.get('id', '?')} ({fm.get('title', '')})"
                break
    print(f"【中断任务】: {active_story}")

    # 2. Git 状态
    dirty = _gather_dirty_files(cwd)
    if dirty:
        print(f"【工作区状态】: 存在未提交修改 (Dirty Working Tree: {len(dirty)} 文件)")
        for status_prefix, fname in dirty[:5]:
            print(f"  - {fname}  [{status_prefix.strip()}]")
    else:
        print("【工作区状态】: 干净 (Clean Working Tree)")

    # 3. AST 符号
    filenames = [f for _, f in dirty] if dirty else []
    symbols = _extract_python_symbols(cwd, filenames)
    if symbols:
        print("【CodeGraph 语义感知】:")
        for sym in symbols[:5]:
            print(f"  - 触及符号: {sym}")
        # 写到符号缓存，供 sync 写回 Story.impacted_symbols
        if active_story != "无":
            sid = active_story.split()[0]
            cache_path = cwd / SYMBOLS_CACHE
            cache_path.parent.mkdir(parents=True, exist_ok=True)
            cache: dict[str, list[str]] = {}
            if cache_path.exists():
                cache = yaml.safe_load(cache_path.read_text()) or {}
            cache[sid] = [s.split("`")[1] for s in symbols if "`" in s]
            cache_path.write_text(yaml.safe_dump(cache, allow_unicode=True))
            print(f"  -> 符号已缓存到 {SYMBOLS_CACHE}")

    # 4. 测试探针
    test_files = [f for _, f in dirty if "test" in f]
    if test_files or (cwd / "tests").exists():
        try:
            t_res = subprocess.run(
                ["pytest", "-q", "--tb=no"],
                cwd=cwd, capture_output=True, text=True, check=False,
            )
            lines = [l for l in t_res.stdout.split("\n") if l.strip()]
            tail = lines[-5:] if lines else []
            print(f"【测试探针当前结果】: returncode={t_res.returncode}")
            for l in tail:
                print(f"  {l}")
        except Exception:
            print("【测试探针当前结果】: pytest 未安装，跳过")

    print("【接力建议】: 请结合上述断点信息直接继续开发或调试。")
    print("========================================================================")


# triage 是 resume 的别名
cmd_triage = cmd_resume


# ============ impact ============


def cmd_impact(args):
    cwd = Path.cwd()
    target_symbol = args.target
    if not target_symbol:
        print("error: 请提供目标符号名或文件名", file=sys.stderr)
        sys.exit(1)

    print(f"【CodeGraph 影响面分析】: 目标 `{target_symbol}`")
    matches = []
    for py_file in cwd.rglob("*.py"):
        if ".pytest_cache" in str(py_file) or "__pycache__" in str(py_file):
            continue
        try:
            content = py_file.read_text(encoding="utf-8")
            if target_symbol in content:
                rel = py_file.relative_to(cwd)
                matches.append(str(rel))
        except Exception:
            pass

    if matches:
        print(f"  关联/调用文件 ({len(matches)} 处):")
        for m in matches:
            print(f"  - {m}")
    else:
        print("  未发现跨文件引用。")


# ============ entry ============


def cmd_install(args):
    """Install the agentrace skill + user-level snippet globally."""
    import shutil
    import os

    cwd = Path.cwd()
    skill_src = cwd / ".claude/skills/agentrace"
    snippet_src = cwd / "adapters/snippets/claude.md"

    if not skill_src.exists():
        print(f"error: {skill_src} 不存在，无法安装", file=sys.stderr)
        sys.exit(1)

    home = Path(os.environ.get("HOME", str(Path.home())))
    skill_dst = home / ".claude/skills/agentrace"

    if skill_dst.exists():
        shutil.rmtree(skill_dst)
    shutil.copytree(skill_src, skill_dst)
    print(f"installed: skill copied to {skill_dst}")

    if snippet_src.exists():
        class _A: pass
        a = _A()
        a.agent = "claude"
        cmd_install_snippet(a)
    else:
        print(f"warning: {snippet_src} 不存在，跳过 snippet 安装", file=sys.stderr)

    print("")
    print("agentrace 已全局安装。下一步:")
    print("  - 在 Claude Code 里直接说 'review S-001' / 'start a story' 等触发 skill")
    print("  - 在新项目里跑 `agentrace init` 创建项目级协议")


def cmd_uninstall(args):
    """Remove globally installed agentrace skill + user-level snippet."""
    import os
    import re

    home = Path(os.environ.get("HOME", str(Path.home())))
    skill_dst = home / ".claude/skills/agentrace"
    claude_md = home / ".claude/CLAUDE.md"

    if skill_dst.exists():
        import shutil
        shutil.rmtree(skill_dst)
        print(f"removed: {skill_dst}")
    else:
        print("info: skill 未安装，跳过")

    if claude_md.exists():
        text = claude_md.read_text()
        pattern = re.compile(
            r"\n*<!-- BEGIN agentrace protocol v[\d.]+.*?-->.*?<!-- END agentrace protocol v[\d.]+.*?-->\n*",
            re.DOTALL,
        )
        new_text = pattern.sub("\n", text, count=1)
        if new_text != text:
            claude_md.write_text(new_text)
            print(f"cleaned: agentrace snippet removed from {claude_md}")
        else:
            print("info: CLAUDE.md 中未发现 agentrace snippet")


def main():
    parser = argparse.ArgumentParser(prog="agentrace", description="agentrace 协议 CLI")
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("init")
    subparsers.add_parser("install")
    subparsers.add_parser("uninstall")
    p_install_snippet = subparsers.add_parser("install-snippet")
    p_install_snippet.add_argument("--agent", default=None)

    p_new_story = subparsers.add_parser("new-story")
    p_new_story.add_argument("--title", default="")

    p_new_review = subparsers.add_parser("new-review")
    p_new_review.add_argument("story_id")

    p_advance = subparsers.add_parser("advance")
    p_advance.add_argument("story_id")
    p_advance.add_argument("new_status")

    subparsers.add_parser("sync")
    p_check = subparsers.add_parser("check")
    p_check.add_argument("--strict", action="store_true")
    p_check.add_argument("--fix", action="store_true")

    subparsers.add_parser("render")
    subparsers.add_parser("resume")
    subparsers.add_parser("triage")

    p_impact = subparsers.add_parser("impact")
    p_impact.add_argument("target", nargs="?", default="")

    args = parser.parse_args()

    handlers = {
        "init": cmd_init,
        "install": cmd_install,
        "uninstall": cmd_uninstall,
        "install-snippet": cmd_install_snippet,
        "new-story": cmd_new_story,
        "new-review": cmd_new_review,
        "advance": cmd_advance,
        "sync": cmd_sync,
        "check": cmd_check,
        "render": cmd_render,
        "resume": cmd_resume,
        "triage": cmd_triage,
        "impact": cmd_impact,
    }
    handlers[args.command](args)


if __name__ == "__main__":
    main()